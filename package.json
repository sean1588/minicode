{
  "name": "@sean.holung/minicode",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A coding agent for mini models",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "minicode": "dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@minicode/agent-sdk"
  ],
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev": "node scripts/build-web.mjs && node --env-file=.env --import tsx src/index.ts",
    "dev:ink": "CLI_UI_MODE=ink node --env-file=.env --import tsx src/index.ts",
    "build": "npm run build --workspace=packages/agent-sdk && tsc -p tsconfig.json && node scripts/build-web.mjs && chmod +x dist/src/index.js",
    "start": "node dist/src/index.js",
    "install:global": "npm run build && npm link",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\" --max-warnings=0",
    "pretest": "npm run build --workspace=packages/agent-sdk && node scripts/build-web.mjs",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "verify-index": "node --import tsx test-programs/verify-index/verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@inkjs/ui": "^2.0.0",
    "@minicode/agent-sdk": "*",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.4",
    "typescript": "^5.9.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.0"
  }
}
