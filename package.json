{
  "name": "@sean.holung/minicode",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A coding agent for mini models",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "minicode": "dist/src/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@anthropic-ai/sdk",
    "@inkjs/ui",
    "@minicode/agent-sdk",
    "@modelcontextprotocol/sdk",
    "ajv",
    "dotenv",
    "ink",
    "marked",
    "minicode-plugin-python",
    "picocolors",
    "react",
    "tree-sitter",
    "tree-sitter-python",
    "typescript",
    "ws",
    "zod"
  ],
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:workspaces": "npm run build --workspace=packages/agent-sdk && npm run build --workspace=packages/minicode-plugin-python",
    "dev": "npm run build:workspaces && node scripts/build-web.mjs && node --import tsx src/index.ts",
    "dev:ink": "npm run build:workspaces && node scripts/build-web.mjs && CLI_UI_MODE=ink node --import tsx src/index.ts",
    "build": "npm run build:workspaces && tsc -p tsconfig.json && node scripts/build-web.mjs && chmod +x dist/src/index.js",
    "start": "node dist/src/index.js",
    "install:global": "npm run build && npm link",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\" --max-warnings=0",
    "pretest": "npm run build:workspaces && node scripts/build-web.mjs",
    "test": "node --test --import tsx \"tests/**/*.test.ts\" \"packages/*/tests/**/*.test.ts\"",
    "verify-index": "node --import tsx test-programs/verify-index/verify.ts",
    "benchmark": "node --import tsx scripts/run-benchmarks.ts",
    "benchmark:ts-bench": "bash ./scripts/run-ts-bench.sh",
    "benchmark:ccbench:js-ts": "bash ./scripts/run-ccbench-js-ts.sh",
    "benchmark:swebench": "bash ./scripts/run-swebench-verified.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "@inkjs/ui": "^2.0.0",
    "@minicode/agent-sdk": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.18.0",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "marked": "^17.0.5",
    "minicode-plugin-python": "*",
    "picocolors": "^1.1.1",
    "react": "^19.2.4",
    "tree-sitter": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "typescript": "^5.9.3",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.0"
  }
}
