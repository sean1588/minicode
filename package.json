{
  "name": "mini-coder",
  "version": "0.1.0",
  "private": true,
  "description": "MVP autonomous coding agent CLI",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mini-coder": "dist/src/index.js"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "install:global": "npm run build && npm link",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings=0",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "verify-index": "node --import tsx test-programs/verify-index/verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.76.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
