# ~/.minicode/.env — secrets and persisted runtime settings
# Only set what you need. Built-in defaults apply for anything omitted.

# ── Provider: pick ONE section ──

# Local model (LM Studio, Ollama, etc.)
MODEL_PROVIDER=openai-compatible
MODEL=your-model-name
OPENAI_BASE_URL=http://localhost:1234/v1

# Anthropic
# MODEL_PROVIDER=anthropic
# MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter
# MODEL_PROVIDER=openai-compatible
# MODEL=your-model-name
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...

# Optional runtime tuning
# ENABLE_DYNAMIC_PROMPT=true
